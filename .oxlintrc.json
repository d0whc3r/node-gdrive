{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist/**", "bin/**", "coverage/**", "node_modules/**"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-debugger": "error",
    "no-console": "off"
  }
}
