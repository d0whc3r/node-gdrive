TOKEN_FILE=./secrets/token.json
CREDENTIALS_FILE=./secrets/credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Optional client-side encryption passphrase for --encrypt (AES-256-GCM)
# BACKUP_ENCRYPTION_KEY=change-me-to-a-strong-passphrase

# Optional: Unified database connection URI (auto-detects postgres, mysql/mariadb, mongodb, sqlite)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Optional: PostgreSQL (--db postgres)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=secret
# PGDATABASE=mydb
# PGSSLMODE=prefer

# Optional: MySQL / MariaDB (--db mysql or -m)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=mydb

# Optional: MongoDB (--db mongodb)
# MONGODB_URI=mongodb://user:password@localhost:27017/mydb
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_USER=root
# MONGO_PASSWORD=secret
# MONGO_DATABASE=mydb
# MONGO_AUTH_DB=admin

# Optional: SQLite (--db sqlite)
# SQLITE_PATH=./data/app.sqlite
