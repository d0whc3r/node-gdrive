{
  "name": "@d0whc3r/node-gdrive",
  "version": "3.5.1",
  "keywords": [
    "backup",
    "compress",
    "copy",
    "drive",
    "gdrive",
    "google",
    "googleapi",
    "node",
    "upload"
  ],
  "license": "MIT",
  "author": {
    "name": "d0whc3r",
    "email": "d0whc3r@gmail.com",
    "url": "https://github.com/d0whc3r"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d0whc3r/node-gdrive.git"
  },
  "bin": {
    "node-gdrive": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "main": "dist/gdrive.cjs.js",
  "module": "dist/gdrive.esm.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gdrive.esm.mjs",
      "require": "./dist/gdrive.cjs.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => ['dist','bin','build','coverage','node-gdrive','node-gdrive.exe'].forEach(p => fs.rmSync(p, {recursive:true,force:true})))\"",
    "cli:dev": "node --env-file=.env cli/cli.ts",
    "cli": "node cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "build:clean": "node -e \"import('node:fs').then(fs => ['dist','bin'].forEach(p => fs.rmSync(p, {recursive:true,force:true})))\"",
    "build:lib": "vite build --config vite.config.mts",
    "build:cli": "vite build --config vite.cli.config.mts",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:base": "pnpm build:clean && pnpm build:lib && pnpm build:cli && pnpm build:dts",
    "build:sea": "vite build --config vite.sea.config.mts && node scripts/build-sea.mjs",
    "build": "pnpm build:base && pnpm build:sea",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/gdrive.integration.spec.ts",
    "test:integration": "vitest run tests/gdrive.integration.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "archiver": "^8.0.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "dayjs": "^1.11.23",
    "google-auth-library": "^11.3.4",
    "mime-types": "^3.0.2",
    "mysqldump": "^3.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/archiver": "^8.0.0",
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "semantic-release": "^26.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "lint-staged": {
    "{src,cli,tests}/**/*.ts": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
